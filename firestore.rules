rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Las listas solo pueden ser leídas o modificadas por su creador o por personas explícitamente invitadas en 'members'
    match /lists/{listId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.ownerId == request.auth.uid || request.auth.email in resource.data.members);
    }
  }
}
